  },
  "bugs": {
    "url": "https://github.com/linksplatform/Data.Doublets.Gql/issues"
  },
  "homepage": "https://github.com/linksplatform/Data.Doublets.Gql#readme",
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.29.0",
    "rollup-plugin-dts": "^6.0.2",
